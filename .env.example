# ==============================================================================
# Environment Configuration Example for Zotero ArXiv Daily
# Copy this file to .env and fill in your credentials.
# IMPORTANT: Never commit .env or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Zotero API Credentials
# ------------------------------------------------------------------------------
# Your Zotero User ID (integer). Find it at https://www.zotero.org/settings/keys
ZOTERO_ID=12345678

# Your Zotero API Key with read permissions. Generate at https://www.zotero.org/settings/keys/new
ZOTERO_KEY=your_zotero_api_key_here

# ------------------------------------------------------------------------------
# SMTP / Email Delivery Credentials
# ------------------------------------------------------------------------------
# The SMTP server host (e.g. smtp.tem.scaleway.com, smtp.gmail.com, smtp.sendgrid.net)
SMTP_SERVER=smtp.tem.scaleway.com

# SMTP port (587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT=587

# SMTP authentication username
SMTP_USERNAME=your_smtp_username_here

# SMTP authentication password or App Password
SMTP_PASSWORD=your_smtp_password_or_token_here

# Sender email address
SMTP_SENDER=digest@yourdomain.com

# Receiver email address (where the daily digest email is delivered)
SMTP_RECEIVER=you@example.com

# ------------------------------------------------------------------------------
# LLM (Summarization & TL;DR Generation)
# ------------------------------------------------------------------------------
# API key for the LLM service (Gemini or OpenAI)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
LLM_API_KEY=AIzaSyYourGeminiApiKeyHere

# Base URL for the OpenAI-compatible endpoint
# For Google Gemini OpenAI-compatible API:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# For OpenAI direct API:
# LLM_BASE_URL=https://api.openai.com/v1

# Model identifier for text generation (TL;DRs)
LLM_MODEL=gemini-3.8-flash
# Alternative: gemini-3.5-flash-lite, gpt-4o-mini

# ------------------------------------------------------------------------------
# Reranker / Embeddings (Relevance Scoring against Zotero Corpus)
# ------------------------------------------------------------------------------
# API key for the embedding service
EMBEDDING_API_KEY=AIzaSyYourGeminiApiKeyHere

# Base URL for the embedding service
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Alternative for OpenAI:
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Model identifier for vector embeddings
EMBEDDING_MODEL=gemini-embedding-2
# Alternative: text-embedding-3-large

# ------------------------------------------------------------------------------
# Application & Testing Flags
# ------------------------------------------------------------------------------
# Debug mode: true limits fetched papers for faster testing
DEBUG=true

# NO_EMAIL: set to true to suppress actual SMTP dispatch during tests
NO_EMAIL=true

# SAVE_EMAIL_PATH: output file path where the generated HTML email is saved
SAVE_EMAIL_PATH=email_output.html
