#!/usr/bin/env bash
set -e

echo "🔍 Running pre-commit hooks..."

# 1. Check linting with Ruff
echo "  → Checking linting (ruff check)..."
if ! uv run ruff check .; then
    echo ""
    echo "❌ Ruff lint check failed! Fix the errors above or run:"
    echo "   uv run ruff check --fix ."
    exit 1
fi

# 2. Check formatting with Ruff
echo "  → Checking formatting (ruff format --check)..."
if ! uv run ruff format --check .; then
    echo ""
    echo "❌ Ruff format check failed! Fix the formatting above or run:"
    echo "   uv run ruff format ."
    exit 1
fi

# 3. Run fast unit tests
echo "  → Running unit tests (pytest)..."
if ! uv run pytest -q; then
    echo ""
    echo "❌ Unit tests failed! Please fix failing tests before committing."
    exit 1
fi

echo "✅ All pre-commit checks passed successfully!"
exit 0
