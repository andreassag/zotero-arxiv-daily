#!/usr/bin/env bash
# ==============================================================================
# Git pre-commit hook:
# 1. Format Go code (gofmt)
# 2. Lint codebase (golangci-lint / go vet)
# 3. Detect and block secrets / sensitive files
# ==============================================================================
set -e

RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
RESET="\033[0m"

echo -e "${CYAN}==> [pre-commit] Running security & quality checks...${RESET}"

# ------------------------------------------------------------------------------
# 1. Check for sensitive files staged for commit
# ------------------------------------------------------------------------------
echo -e "${CYAN}==> [1/3] Checking for forbidden / sensitive files...${RESET}"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

FORBIDDEN_FILE_PATTERNS=(
    '^\.env(\..+)?$'
    '.*\.pem$'
    '.*\.key$'
    '.*\.p12$'
    '.*\.pfx$'
    '.*id_rsa.*'
    '.*id_ed25519.*'
    '.*\.pkcs12$'
    '.*credentials\.json$'
    '.*service[-_]account.*\.json$'
)

SENSITIVE_FILES_FOUND=0
for FILE in $STAGED_FILES; do
    # Skip .env.example
    if [ "$FILE" = ".env.example" ] || [ "$FILE" = ".env.example.yaml" ]; then
        continue
    fi

    for PATTERN in "${FORBIDDEN_FILE_PATTERNS[@]}"; do
        if echo "$FILE" | grep -qE "$PATTERN"; then
            echo -e "${RED}✖ [SECURITY ALERT] Attempting to commit sensitive file:${RESET} $FILE"
            SENSITIVE_FILES_FOUND=1
        fi
    done
done

if [ $SENSITIVE_FILES_FOUND -ne 0 ]; then
    echo -e "${RED}Commit rejected! Remove sensitive files from git staging using 'git rm --cached <file>'.${RESET}"
    exit 1
fi

# ------------------------------------------------------------------------------
# 2. Scan staged content for hardcoded secrets / API tokens
# ------------------------------------------------------------------------------
echo -e "${CYAN}==> [2/3] Scanning staged changes for credentials and secret leaks...${RESET}"

# If gitleaks is installed, run it first for deep entropy analysis
if command -v gitleaks &>/dev/null; then
    if ! gitleaks protect --staged --verbose; then
        echo -e "${RED}✖ [SECURITY ALERT] Gitleaks detected potential credentials in staged changes!${RESET}"
        exit 1
    fi
fi

# Built-in regex scanner on staged additions (excludes deletions and unchanged lines)
STAGED_DIFF=$(git diff --cached -U0 --diff-filter=ACM | grep -E '^\+[^\+]' || true)

SECRET_PATTERNS=(
    '-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----'                          # Private Keys
    'sk-[a-zA-Z0-9_\-]{24,}'                                         # OpenAI API Keys
    'AIza[0-9A-Za-z\-_]{35}'                                         # Google / Gemini API Keys
    'gh[pousr]_[0-9a-zA-Z]{36,}'                                     # GitHub Tokens
    'AKIA[0-9A-Z]{16}'                                               # AWS Access Key
    'xox[baprs]-[0-9a-zA-Z]{10,}'                                    # Slack Tokens
    '(password|secret|api_key|token)[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{10,}["'\'']' # Generic secrets
)

SECRET_FOUND=0
for PATTERN in "${SECRET_PATTERNS[@]}"; do
    MATCHES=$(echo "$STAGED_DIFF" | grep -n -E -e "$PATTERN" | grep -vE '\$\{oc\.env:|\$\{ENV:|\$ENV|\.env\.example|your_|example_' || true)
    if [ -n "$MATCHES" ]; then
        echo -e "${RED}✖ [SECURITY ALERT] Potential secret or private key pattern detected in staged changes:${RESET}"
        echo "$MATCHES" | head -n 5
        SECRET_FOUND=1
    fi
done

if [ $SECRET_FOUND -ne 0 ]; then
    echo -e "${RED}Commit rejected to prevent leaking secrets! Use environment variables or GitHub secrets instead.${RESET}"
    echo -e "${YELLOW}(If this is a false positive, verify manually and use 'git commit --no-verify' to bypass).${RESET}"
    exit 1
fi

# ------------------------------------------------------------------------------
# 3. Format and lint Go code
# ------------------------------------------------------------------------------
echo -e "${CYAN}==> [3/3] Checking Go formatting and running linters...${RESET}"

GO_FILES=$(echo "$STAGED_FILES" | grep -E '\.go$' || true)

if [ -n "$GO_FILES" ]; then
    # Run gofmt
    UNFORMATTED=$(gofmt -l $GO_FILES)
    if [ -n "$UNFORMATTED" ]; then
        echo -e "${YELLOW}Notice: Formatting the following Go files with gofmt:${RESET}"
        echo "$UNFORMATTED"
        gofmt -w $GO_FILES
        git add $GO_FILES
    fi

    # Run linter
    if command -v golangci-lint &>/dev/null; then
        if ! golangci-lint run ./...; then
            echo -e "${RED}✖ [LINT ERROR] golangci-lint reported issues. Please fix them before committing.${RESET}"
            exit 1
        fi
    else
        echo -e "${YELLOW}golangci-lint not found, falling back to 'go vet ./...'${RESET}"
        if ! go vet ./...; then
            echo -e "${RED}✖ [LINT ERROR] go vet reported issues. Please fix them before committing.${RESET}"
            exit 1
        fi
    fi
fi

echo -e "${GREEN}✔ [pre-commit] All quality and security checks passed!${RESET}"
exit 0
