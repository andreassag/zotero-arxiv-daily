# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.go text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.pdf binary
